@page
@model AdminPortal.Areas.Identity.Pages.User.EditModel
@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>User</h4>
<hr />
<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.UserVM.Email)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.UserVM.Email)
    </dd>
</dl>

<h4>Role</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UserVM.Id" />

            <div class="form-group">
                <select asp-for="SelectRoles" asp-items="Model.RoleOptions">
                </select>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}