@page
@model AdminPortal.Areas.Identity.Pages.Role.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Role</h4>
<hr />
<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Role.Name)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Role.Name)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Role.NormalizedName)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Role.NormalizedName)
    </dd>
</dl>

<h4>Permission</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Role.Id" />

            @for (int i = 0; i < Model.Permissions.Count; i++)
            {
                <div>
                    <input type="checkbox" asp-for="Permissions[i].Selected" />
                    <input type="hidden" asp-for="Permissions[i].PermissionName" />
                    <label>@Model.Permissions[i].PermissionName</label>
                </div>
            }
            
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
