@page
@model AdminPortal.Areas.Identity.Pages.Role.DetailModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Role</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Role.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Role.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Role.NormalizedName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Role.NormalizedName)
        </dd>
    </dl>

    <h4>Permission</h4>
    <hr/>

    <dl class="row">
        <dt class="col-sm-2">
            权限
        </dt>
        <dd class="col-sm-10">
            @for (int i = 0; i < Model.Permissions.Count; i++)
            {
                <div>@Model.Permissions[i].PermissionDisplayName</div>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Role.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>