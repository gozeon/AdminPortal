@page "/AppFiles/Preview/{id:int}"
@model AdminPortal.Pages.AppFiles.PreviewModel
@using AdminPortal.Services.FilePreview

@{
	ViewData["Title"] = "文件预览";
	Layout = null;
}

@if (Model.PreviewResult.Success)
{
	@switch (Model.PreviewResult.PreviewType)
	{
		case FilePreviewType.Image:
			<partial name="_ImagePreview" model="Model"></partial>
			break;
		case FilePreviewType.PDF:
			<partial name="_PdfPreview" model="Model"></partial>
			break;
		case FilePreviewType.Text:
			<partial name="_TextPreview" model="Model"></partial>
			break;
		default:
			<partial name="_UnsupportedPreview" model="Model"></partial>
			break;
	}
}
else
{
	<partial name="_UnsupportedPreview" model="Model"></partial>
}
