@page
@model AdminPortal.Pages.AppFiles.IndexModel
@using Humanizer
@using X.PagedList.Mvc.Core
@{
}

@{
	ViewData["Title"] = "文件管理";
}

<h2>文件管理</h2>

<hr />

<partial asp-permission="Permission:AppFile.Add" name="_UploadPartial" model="Model"/>

<h4>文件列表</h4>

<table class="table table-bordered table-striped">
	<thead>
		<tr>
			<th>名称</th>
			<th>大小</th>
			<th>类型</th>
			<th>上传时间</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var file in Model.AppFilesPagedList)
		{
			<tr>
				<td>
					<a href="@file.Url" target="_blank">
						@file.OriginalName
					</a>
				</td>
				<td>@file.Size.Bytes().Humanize()</td>
				<td>@file.ContentType</td>
				<td>@file.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
				<td>
					<a href="/AppFiles/Preview/@file.Id" class="btn btn-sm btn-info" title="预览">
						<i class="fas fa-eye"></i> 预览
					</a>
				</td>
			</tr>
		}
	</tbody>
</table>

@Html.PagedListPager(Model.AppFilesPagedList,
	page => Url.Page("Index", new { pageNumber=page, pageSize=Model.Query.PageSize }),
	new PagedListRenderOptions
	{
		LiElementClasses = new string[] { "page-item" },
		PageClasses = new string[] { "page-link" }
	})

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
